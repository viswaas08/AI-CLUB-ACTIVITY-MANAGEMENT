rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // PUBLIC READ: Verification route does not require authentication
    match /certificates/{certificateId} {
      allow read: if true;
      // All writes must originate via Cloud Functions or Super Admin
      allow create, update, delete: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superAdmin';
    }

    match /auditLogs/{logId} {
      allow read: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['faculty', 'superAdmin'];
      allow write: if false; // Cloud Functions exclusively
    }

    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
