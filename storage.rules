rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Generated PDF Certificates are publicly readable by verification URL
    match /certificates/{certificateId} {
      allow read: if true;
      allow write: if request.auth != null && 
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['clubAdmin', 'faculty', 'superAdmin'];
    }

    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
